{
  "name": "dloop-filament-studio-v2",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test:phase9": "node scripts/run-phase9-qr-wifi.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/verify-static.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:stock": "node scripts/check-stock.mjs",
    "test:api": "node scripts/check-api.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "test:php:http": "node backend/tests/http.mjs",
    "test:php:auth": "node backend/tests/auth-database.mjs",
    "test:php": "node scripts/check-php.mjs",
    "test:inventory:http": "node backend/tests/inventory-http.mjs",
    "test:inventory:concurrency": "node backend/tests/inventory-concurrency.mjs",
    "test:inventory:ui": "node scripts/check-inventory-ui.mjs",
    "test:scale": "node scripts/check-scale.mjs",
    "test:scale:ui": "node scripts/check-scale-ui.mjs",
    "test:scale:preview": "node scripts/check-live-preview.mjs",
    "test:scale:unverified": "node scripts/check-unverified-preview.mjs",
    "test:scale:remaining": "node scripts/check-remaining-filament.mjs && node scripts/check-remaining-filament-ui.mjs",
    "test:scale:usb-diagnostics": "node scripts/check-usb-preview-diagnostics.mjs",
    "test:scale:inventory-e2e": "node scripts/run-live-estimate-e2e.mjs",
    "test:scale:wifi": "node scripts/check-wifi-scale-transport.mjs && node scripts/check-wifi-scale-ui.mjs",
    "test:spool:preprinted": "node scripts/check-preprinted-qr-ui.mjs && node scripts/check-preprinted-qr-pdf.mjs",
    "test:spool:qr": "node scripts/check-spool-qr.mjs && node scripts/check-spool-qr-ui.mjs",
    "prepare:staging": "npm run build && node scripts/prepare-production.mjs --staging",
    "prepare:production": "npm run build && node scripts/prepare-production.mjs",
    "test:spool:identity": "node scripts/check-spool-identification.mjs",
    "test:spool:ui": "node scripts/check-spool-workflows-ui.mjs",
    "test:local:policy": "node scripts/check-local-loopback.mjs",
    "test:local:http": "node scripts/check-local-single-user.mjs",
    "test:scale:api": "node backend/tests/scale-http.mjs",
    "test:scale:live": "node scripts/check-scale-live-ui.mjs",
    "test:firmware": "node scripts/check-firmware-protocol.mjs",
    "test:diagnostics": "node scripts/check-sampling-diagnostics.mjs",
    "test:scale:approximate": "node scripts/check-approximate-protocol.mjs",
    "test:scale:approx-calibration": "node scripts/check-approximate-calibration.mjs",
    "test:management": "node scripts/check-mobile-management.mjs",
    "test:staging:package": "node scripts/check-staging-packaging.mjs",
    "test:catalogue:hotfix": "node scripts/check-catalogue-hotfix.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
